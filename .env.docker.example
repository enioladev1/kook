# Copy this to .env.docker and fill in the values below, then run:
#   docker compose --env-file .env.docker up -d

# Generate with: php artisan key:generate --show
APP_KEY=

# Your real public domain, e.g. https://kook.example.com
APP_URL=

# A strong password - this becomes the Postgres superuser password too.
DB_PASSWORD=

# Comma-separated, no spaces, no trailing slash. Must match APP_URL's origin.
CORS_ALLOWED_ORIGINS=

# --- Optional overrides (uncomment to change from the defaults) ---
# APP_NAME=Kook
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# DB_DATABASE=kook
# DB_USERNAME=kook
# APP_PORT=8080
